<html>
<head>
	<title>use of rowspom</title>
</head>
<body>
	<table border="1">
		<tr>
	<td rowspan="3">1</td>
	<td>2</td><td>3</td>
	<td>2</td><td>3</td>
    </tr>
    <tr><td>4</td><td>5</td></tr>
    <tr><td>6</td><td>8</td></tr>
    <tr><td>9</td><td>10</td><td>11</td>
    </tr>
</table>
</body>
</html>
